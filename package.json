{
  "name": "pixijs-itchio-template",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "scripts": {
    "start": "pnpm run dev",
    "build": "pnpm run check && vite build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && butler push dist",
    "itch:login": "butler login",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
